<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 12+: blur the app behind dialogs and sheets, with a lighter dim to match -->
    <style name="ThemeOverlay.TestTube.AlertDialog" parent="Base.ThemeOverlay.TestTube.AlertDialog">
        <item name="android:windowBlurBehindEnabled">true</item>
        <item name="android:windowBlurBehindRadius">24dp</item>
        <item name="android:backgroundDimAmount">0.45</item>
    </style>

    <style name="ThemeOverlay.TestTube.BottomSheetDialog" parent="Base.ThemeOverlay.TestTube.BottomSheetDialog">
        <item name="android:windowBlurBehindEnabled">true</item>
        <item name="android:windowBlurBehindRadius">24dp</item>
        <item name="android:backgroundDimAmount">0.35</item>
    </style>
</resources>
