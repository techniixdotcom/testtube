<?xml version="1.0" encoding="utf-8"?>
<!--
    JetBrains Mono 2.304, the typeface of niixa.org, for all text in the app.
    SIL Open Font License 1.1, see assets/licenses/JetBrainsMono-OFL.txt.

    Trimmed to what text needs: Latin (with Turkish and Vietnamese), Greek, Cyrillic,
    punctuation, currency, arrows, maths and common symbols, ligatures included. Box drawing,
    block elements, Braille and the like were dropped; the odd title using them falls back to
    the phone's font for just those characters. Nothing asks for ExtraBold, so it's gone too.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/jetbrains_mono_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/jetbrains_mono_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />
    <font
        android:font="@font/jetbrains_mono_medium"
        android:fontStyle="normal"
        android:fontWeight="500"
        app:font="@font/jetbrains_mono_medium"
        app:fontStyle="normal"
        app:fontWeight="500" />
    <font
        android:font="@font/jetbrains_mono_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/jetbrains_mono_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />
</font-family>
