<?xml version="1.0" encoding="utf-8"?>
<!--
    Browser-style tab: the selected tab has the page colour and rounded top corners, so it
    joins the page below, with a short accent line along its top edge.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="150"
    android:exitFadeDuration="150">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/surface_container" />
                    <corners
                        android:topLeftRadius="12dp"
                        android:topRightRadius="12dp" />
                </shape>
            </item>
            <item
                android:height="3dp"
                android:gravity="top"
                android:left="16dp"
                android:right="16dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/accent" />
                    <corners
                        android:bottomLeftRadius="2dp"
                        android:bottomRightRadius="2dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
