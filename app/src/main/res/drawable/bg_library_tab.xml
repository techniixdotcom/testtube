<?xml version="1.0" encoding="utf-8"?>
<!--
    Browser-style tab: selected one has the Library page colour and rounded top corners so it
    joins the page. The edge colour fills the tab and the page colour sits 3dp lower with the same
    corners, leaving a lit band across the top and down both corners.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="150"
    android:exitFadeDuration="150">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="?attr/colorPrimary" />
                    <corners
                        android:topLeftRadius="12dp"
                        android:topRightRadius="12dp" />
                </shape>
            </item>
            <item android:top="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="?attr/ttLibraryPage" />
                    <corners
                        android:topLeftRadius="12dp"
                        android:topRightRadius="12dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
