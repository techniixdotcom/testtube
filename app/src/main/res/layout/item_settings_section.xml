<?xml version="1.0" encoding="utf-8"?>
<!-- A titled group of settings rows on a rounded card -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:orientation="vertical">

    <TextView
        android:id="@+id/section_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="8dp"
        android:paddingBottom="8dp"
        android:textAppearance="@style/TextAppearance.TestTube.SectionHeader" />

    <LinearLayout
        android:id="@+id/section_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_settings_group"
        android:clipToOutline="true"
        android:divider="@drawable/divider_settings"
        android:orientation="vertical"
        android:showDividers="middle" />
</LinearLayout>
