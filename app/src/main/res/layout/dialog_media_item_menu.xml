<?xml version="1.0" encoding="utf-8"?>
<!--
    Long-press menu: rounded picture, title and channel, then one list of actions. Every row looks
    the same (icon and label in the text colour) so nothing shouts. One hairline splits video
    actions from "about this video".
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/media_item_thumb"
            android:layout_width="match_parent"
            android:layout_height="176dp"
            android:background="?attr/colorSurfaceContainerHighest"
            android:contentDescription="@string/thumbnail"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_thumbnail_placeholder"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.TestTube.Banner" />

        <ImageButton
            android:id="@+id/media_item_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:background="@drawable/bg_icon_on_picture"
            android:contentDescription="@string/close"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_close"
            android:theme="@style/ThemeOverlay.TestTube.OnVideo"
            app:tint="@android:color/white" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/media_item_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="14dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface"
                android:textIsSelectable="true"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/media_item_author"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/action_queue"
                style="@style/Widget.TestTube.MenuRow"
                android:layout_marginTop="10dp"
                android:drawableStart="@drawable/ic_queue_add"
                android:text="@string/add_to_queue" />

            <TextView
                android:id="@+id/action_play_next"
                style="@style/Widget.TestTube.MenuRow"
                android:drawableStart="@drawable/ic_queue_play_next"
                android:text="@string/play_next" />

            <TextView
                android:id="@+id/action_save"
                style="@style/Widget.TestTube.MenuRow"
                android:drawableStart="@drawable/ic_playlist_add"
                android:text="@string/playlist_save" />

            <TextView
                android:id="@+id/action_share"
                style="@style/Widget.TestTube.MenuRow"
                android:drawableStart="@drawable/ic_share"
                android:text="@string/share" />

            <TextView
                android:id="@+id/action_download"
                style="@style/Widget.TestTube.MenuRow"
                android:drawableStart="@drawable/ic_download"
                android:text="@string/download" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginVertical="6dp"
                android:background="?attr/colorOutlineVariant" />

            <TextView
                android:id="@+id/action_toggle_watched"
                style="@style/Widget.TestTube.MenuRow"
                android:drawableStart="@drawable/ic_watched"
                android:text="@string/mark_as_watched" />

            <TextView
                android:id="@+id/action_block_channel"
                style="@style/Widget.TestTube.MenuRow"
                android:drawableStart="@drawable/ic_block"
                android:text="@string/block_channel" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
