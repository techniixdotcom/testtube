<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Our own colour roles next to Material's. Every theme (themes.xml, themes_niix.xml) sets them,
        so layouts, drawables and code use ?attr/… and follow the chosen theme.
    -->

    <!-- Brand fills: LIVE and "Now playing" badges, placeholders, video progress -->
    <attr name="ttBrand" format="color" />
    <!-- Faint logo behind Home -->
    <attr name="ttLogoWatermark" format="color" />
    <!-- SponsorBlock marks on the progress bar -->
    <attr name="ttSponsorSegment" format="color" />

    <!-- Frosted glass of the mini player and bottom bar -->
    <attr name="ttGlassBar" format="color" />
    <!-- Bars with nothing behind to blur -->
    <attr name="ttGlassBarSolid" format="color" />
    <!-- Line along the top of the bars -->
    <attr name="ttGlassHairline" format="color" />
    <!-- Line around dialogs (transparent for none) -->
    <attr name="ttGlassEdge" format="color" />
    <attr name="ttGlassDialog" format="color" />
    <attr name="ttGlassSheet" format="color" />
    <!-- Long-press menu and settings: the player's colour -->
    <attr name="ttGlassDialogPage" format="color" />

    <!-- Selected bottom tab pill -->
    <attr name="ttNavIndicator" format="color" />
    <!-- Library pages and their selected tab -->
    <attr name="ttLibraryPage" format="color" />
    <!-- Behind a settings group -->
    <attr name="ttSettingsGroup" format="color" />
    <!-- Under a row while it's swiped, plus its logo and label (Add, Follow) -->
    <attr name="ttSwipeBackground" format="color" />
    <attr name="ttSwipeContent" format="color" />

    <!-- Accent on top of video (always dark): spinners. White, pink in NiiX -->
    <attr name="ttOnVideoAccent" format="color" />
    <!-- Username above a comment -->
    <attr name="ttCommentAuthor" format="color" />

    <!--
        Typefaces: a system family ("sans-serif") or bundled font (@font/…). Regular and medium follow
        Material's type scale, mono is for logs.
    -->
    <attr name="ttFontRegular" format="reference|string" />
    <attr name="ttFontMedium" format="reference|string" />
    <attr name="ttFontMono" format="reference|string" />
</resources>
