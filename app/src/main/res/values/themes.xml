<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        Dark and Light, following the phone unless one is picked in settings (colours from
        values/colors.xml or values-notnight/colors.xml). NiiX builds on this (themes_niix.xml). Every
        colour role, Material's and ours (attrs.xml), is mapped once here so everything shares the same
        accent and surfaces without per-view colours.
    -->
    <style name="Base.Theme.TestTube" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorPrimaryContainer">@color/accent_container</item>
        <item name="colorOnPrimaryContainer">@color/on_accent_container</item>
        <item name="colorSecondary">@color/neutral</item>
        <item name="colorOnSecondary">@color/on_neutral</item>
        <item name="colorSecondaryContainer">@color/neutral_container</item>
        <item name="colorOnSecondaryContainer">@color/on_neutral_container</item>
        <item name="colorTertiary">@color/accent</item>
        <item name="colorOnTertiary">@color/on_accent</item>
        <item name="colorTertiaryContainer">@color/accent_container</item>
        <item name="colorOnTertiaryContainer">@color/on_accent_container</item>
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/on_error</item>
        <item name="colorErrorContainer">@color/error_container</item>
        <item name="colorOnErrorContainer">@color/on_error_container</item>

        <item name="android:windowBackground">@color/surface</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="colorOnBackground">@color/on_surface</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_container_highest</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorSurfaceInverse">@color/inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/inverse_on_surface</item>
        <item name="colorSurfaceContainerLowest">@color/surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/surface_container_low</item>
        <item name="colorSurfaceContainer">@color/surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/surface_container_highest</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline_variant</item>
        <item name="elevationOverlayEnabled">false</item>

        <item name="colorAccent">@color/accent</item>
        <item name="colorControlActivated">@color/accent</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:textColorHighlight">@color/text_highlight</item>
        <item name="android:textColorLink">@color/link</item>

        <!-- Our own roles (attrs.xml) -->
        <item name="ttBrand">@color/brand_red</item>
        <item name="ttLogoWatermark">@color/logo_watermark</item>
        <item name="ttSponsorSegment">@color/sponsor_segment</item>
        <item name="ttGlassBar">@color/glass_bar</item>
        <item name="ttGlassBarSolid">@color/glass_bar_solid</item>
        <item name="ttGlassHairline">@color/glass_hairline</item>
        <item name="ttGlassEdge">@color/glass_edge</item>
        <item name="ttGlassDialog">@color/glass_dialog</item>
        <item name="ttGlassSheet">@color/glass_sheet</item>
        <item name="ttGlassDialogPage">@color/glass_dialog_page</item>
        <item name="ttNavIndicator">@color/nav_indicator</item>
        <item name="ttLibraryPage">@color/library_page</item>
        <item name="ttSettingsGroup">@color/settings_group</item>
        <item name="ttSwipeBackground">@color/swipe_background</item>
        <item name="ttSwipeContent">@color/swipe_content</item>
        <item name="ttCommentAuthor">@color/on_surface_variant</item>
        <item name="ttOnVideoAccent">@android:color/white</item>

        <!-- System font in Material's type scale weights -->
        <item name="ttFontRegular">sans-serif</item>
        <item name="ttFontMedium">sans-serif-medium</item>
        <item name="ttFontMono">monospace</item>

        <item name="android:textColorHint">@color/on_surface_variant</item>

        <item name="tabStyle">@style/Widget.TestTube.TabLayout</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.TestTube.AlertDialog</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.TestTube.BottomSheetDialog</item>

        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="28">shortEdges</item>
        <!--
            We have our own dark and light colours. Without this a dark mode phone darkens the light theme
            itself (inverting cards, switches and dialog icons).
        -->
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
        <!--
            Android 16's "expanded dark theme" inverts every app whose theme says light and ignores
            forceDarkAllowed. Like hell: Light was picked on purpose, it stays light.
        -->
        <item name="android:isLightTheme" tools:targetApi="29">false</item>
    </style>

    <style name="Theme.TestTube" parent="Base.Theme.TestTube" />

    <!--
        On video, dark in every theme: white icons, light ripples. Used by the player, floating window
        and Shorts.
    -->
    <style name="ThemeOverlay.TestTube.OnVideo" parent="">
        <!-- player's buffering spinner uses this -->
        <item name="android:colorControlActivated">?attr/ttOnVideoAccent</item>
        <item name="colorControlActivated">?attr/ttOnVideoAccent</item>
        <item name="colorControlNormal">#FFFFFF</item>
        <item name="colorControlHighlight">#33FFFFFF</item>
        <item name="android:colorControlHighlight">#33FFFFFF</item>
    </style>

    <!-- Transparent host for share-to-download -->
    <style name="Theme.Transparent" parent="Theme.TestTube">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!--
        Dialogs: theme surface (see-through in NiiX), soft dim, short fade and grow (blurred behind on
        12+, see values-v31)
    -->
    <style name="Base.ThemeOverlay.TestTube.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="alertDialogStyle">@style/MaterialAlertDialog.TestTube</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="android:windowAnimationStyle">@style/Animation.TestTube.Dialog</item>
    </style>

    <style name="MaterialAlertDialog.TestTube" parent="MaterialAlertDialog.Material3">
        <item name="backgroundTint">?attr/ttGlassDialog</item>
    </style>

    <style name="ThemeOverlay.TestTube.AlertDialog" parent="Base.ThemeOverlay.TestTube.AlertDialog" />

    <!-- Long-press menu and settings: same dialog on the player's colour instead of raised grey -->
    <style name="MaterialAlertDialog.TestTube.Page">
        <item name="backgroundTint">?attr/ttGlassDialogPage</item>
    </style>

    <style name="ThemeOverlay.TestTube.AlertDialog.Page" parent="ThemeOverlay.TestTube.AlertDialog">
        <item name="alertDialogStyle">@style/MaterialAlertDialog.TestTube.Page</item>
    </style>

    <style name="Animation.TestTube.Dialog" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/dialog_exit</item>
    </style>

    <style name="Base.ThemeOverlay.TestTube.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="android:backgroundDimAmount">0.5</item>
        <item name="bottomSheetStyle">@style/Widget.TestTube.BottomSheet</item>
    </style>

    <style name="ThemeOverlay.TestTube.BottomSheetDialog" parent="Base.ThemeOverlay.TestTube.BottomSheetDialog" />

    <style name="Widget.TestTube.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">?attr/ttGlassSheet</item>
        <item name="shapeAppearance">@style/ShapeAppearance.TestTube.BottomSheet</item>
    </style>

    <!-- Tabs under the player and on channel pages -->
    <style name="Widget.TestTube.TabLayout" parent="Widget.Material3.TabLayout">
        <item name="android:background">@android:color/transparent</item>
        <item name="tabIndicatorColor">?attr/colorPrimary</item>
        <item name="tabSelectedTextColor">?attr/colorOnSurface</item>
        <item name="tabTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="tabTextAppearance">@style/TextAppearance.TestTube.PageTab</item>
    </style>

    <!--
        Bottom bar. Background set in code (GlassBackground), so no shadow: a translucent bar would show
        it through itself.
    -->
    <style name="Widget.TestTube.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:minHeight">0dp</item>
        <item name="backgroundTint">?attr/ttGlassBarSolid</item>
        <item name="elevation">0dp</item>
        <item name="itemPaddingTop">1dp</item>
        <item name="itemPaddingBottom">1dp</item>
        <item name="itemIconTint">@color/nav_item_icon</item>
        <item name="itemTextColor">@color/nav_item_text</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.TestTube.NavLabel.Active</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.TestTube.NavLabel</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.TestTube.BottomNav.Indicator</item>
        <!-- Labels on every tab, even with four -->
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <style name="Widget.TestTube.BottomNav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:width">56dp</item>
        <item name="android:height">28dp</item>
        <item name="android:color">?attr/ttNavIndicator</item>
    </style>

    <!-- One Library tab: icon, plus its label while it's the open one -->
    <style name="Widget.TestTube.LibraryTab" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">2dp</item>
        <item name="android:background">@drawable/bg_library_tab</item>
        <item name="android:foreground">@drawable/fg_library_tab</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingHorizontal">8dp</item>
    </style>

    <style name="Widget.TestTube.LibraryTabIcon" parent="">
        <item name="android:layout_width">18dp</item>
        <item name="android:layout_height">18dp</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:duplicateParentState">true</item>
        <item name="tint">@color/library_tab_content</item>
    </style>

    <style name="Widget.TestTube.LibraryTabLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:duplicateParentState">true</item>
        <item name="android:textColor">@color/library_tab_content</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- Menu row: icon and label, rounded highlight on touch (NiiX tints the icon in code) -->
    <style name="Widget.TestTube.MenuRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginHorizontal">8dp</item>
        <item name="android:background">@drawable/bg_menu_row</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:drawablePadding">20dp</item>
        <item name="android:drawableTint">?attr/colorOnSurface</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- Centred icon and message for an empty list -->
    <style name="Widget.TestTube.EmptyState" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">32dp</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:drawableTint">?attr/colorOutline</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:visibility">gone</item>
    </style>

    <!--
        Text. Our text appearances take the typeface from the theme (ttFontRegular, ttFontMedium) so
        they follow NiiX's font too.
    -->
    <style name="TextAppearance.TestTube.NavLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">?attr/ttFontMedium</item>
        <item name="fontFamily">?attr/ttFontMedium</item>
        <item name="android:textSize">10sp</item>
    </style>

    <style name="TextAppearance.TestTube.NavLabel.Active">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.TestTube.PageTab" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:fontFamily">?attr/ttFontMedium</item>
        <item name="fontFamily">?attr/ttFontMedium</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
    </style>

    <!-- Small accent heading above a settings group -->
    <style name="TextAppearance.TestTube.SectionHeader" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">?attr/ttFontMedium</item>
        <item name="fontFamily">?attr/ttFontMedium</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <!-- Settings rows -->
    <style name="Widget.TestTube.SettingTitle" parent="">
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="Widget.TestTube.SettingSummary" parent="">
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textAppearance">?attr/textAppearanceBodySmall</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Title and meta lines for Queue, History and Downloads rows -->
    <style name="TextAppearance.TestTube.ListTitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">?attr/ttFontRegular</item>
        <item name="fontFamily">?attr/ttFontRegular</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.TestTube.ListMeta" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">?attr/ttFontRegular</item>
        <item name="fontFamily">?attr/ttFontRegular</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Shapes -->
    <style name="ShapeAppearance.TestTube.Thumbnail" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeAppearance.TestTube.Banner" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.TestTube.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearance.TestTube.BottomSheet" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">20dp</item>
        <item name="cornerSizeTopRight">20dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
</resources>
